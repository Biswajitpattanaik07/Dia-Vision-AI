# Developer & support details
# Edit the defaults below, or set these values in .env:
#   DEV_NAME, DEV_ROLE, DEV_BIO, DEV_LINKEDIN, DEV_INSTAGRAM,
#   SUPPORT_PHONE, DEV_WHATSAPP, SUPPORT_EMAIL
# Available in EVERY template as {{ dev.name }}, {{ dev.linkedin }}, etc.
# ---------------------------------------------------------------------------
def _digits_for_tel(number):
    import re
    return re.sub(r"[^\d+]", "", number or "")


DEVELOPER_INFO = {
    "name": os.environ.get("DEV_NAME", "Your Name"),
    "role": os.environ.get("DEV_ROLE", "Developer, DiaVision AI"),
    "bio": os.environ.get("DEV_BIO", "Built DiaVision AI to support early diabetic retinopathy screening."),
    "linkedin": os.environ.get("DEV_LINKEDIN", "https://www.linkedin.com/in/your-profile"),
    "instagram": os.environ.get("DEV_INSTAGRAM", "https://www.instagram.com/your_username"),
    "support_phone": os.environ.get("SUPPORT_PHONE", "+91 00000 00000"),
    "support_email": os.environ.get("SUPPORT_EMAIL", "").strip(),
}
DEVELOPER_INFO["support_phone_link"] = _digits_for_tel(DEVELOPER_INFO["support_phone"])
# WhatsApp links use digits only, with the country code and no "+" (e.g. 919876543210).
# Set DEV_WHATSAPP in .env, or it falls back to the support phone number.
DEVELOPER_INFO["whatsapp"] = _digits_for_tel(
    os.environ.get("DEV_WHATSAPP", "") or DEVELOPER_INFO["support_phone"]).replace("+", "")
DEVELOPER_INFO["initial"] = (DEVELOPER_INFO["name"] or "D")[0].upper()


@app.context_processor
def inject_developer_info():
    return {"dev": DEVELOPER_INFO}


