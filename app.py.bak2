# ---------------------------------------------------------------------------
# File serving
# ---------------------------------------------------------------------------
def _migrate_labels(mapping):
    """Renames stored labels (and probability keys) so old results match the
    newly saved class names. Returns how many records changed."""
    changed = 0
    for rec in Analysis.query.all():
        probs = json.loads(rec.probabilities_json)
        new_label = mapping.get(rec.prediction_label, rec.prediction_label)
        new_probs = {mapping.get(k, k): v for k, v in probs.items()}
        if new_label != rec.prediction_label or new_probs != probs:
            rec.prediction_label = new_label
            rec.probabilities_json = json.dumps(new_probs)
            changed += 1
    db.session.commit()
    return changed


@app.route("/settings/classes", methods=["GET", "POST"])
@login_required
def class_setup():
    """Lets the user name the model's outputs and mark which one means
    'not affected', without editing files."""
    n_out = int(MODEL.output_shape[-1]) if MODEL is not None else len(CLASS_NAMES)

    if request.method == "POST":
        names = [request.form.get(f"name_{i}", "").strip() for i in range(n_out)]
        healthy = [names[i] for i in range(n_out) if request.form.get(f"healthy_{i}") and names[i]]
        if any(not n for n in names):
            flash("Please give every output a name.", "error")
        elif len({n.lower() for n in names}) != len(names):
            flash("Each output needs a different name.", "error")
        elif any(len(n) > 40 for n in names):
            flash("Names must be 40 characters or fewer.", "error")
        else:
            mapping = {}
            for i, new in enumerate(names):
                mapping[f"Class {i}"] = new
                if i < len(CLASS_NAMES):
                    mapping[CLASS_NAMES[i]] = new
            if n_out == 3:  # old placeholder DR names used before setup
                for old, i in {"No DR": 0, "Mild DR": 1, "Moderate DR": 2}.items():
                    mapping.setdefault(old, names[i])
            changed = _migrate_labels(mapping)

            with open(CLASS_CONFIG_PATH, "w", encoding="utf-8") as f:
                json.dump({"names": names, "not_affected": healthy,
                           "condition": request.form.get("condition", "").strip()[:80]}, f, indent=2)
            CLASS_NAMES[:] = names
            global CONDITION_NAME
            CONDITION_NAME = request.form.get("condition", "").strip()[:80]
            NOT_AFFECTED_CLASSES[:] = [h.lower() for h in healthy]
            flash(f"Class setup saved. {changed} earlier result(s) were renamed to match.", "success")

            # Non-blocking sanity checks: warn if the ticks and names look inconsistent.
            import re
            sounds_healthy = lambda n: bool(re.search(r"(^|[^a-z])(not|no|non|healthy|normal|negative|control)", n.lower()))
            for n in names:
                ticked = n in healthy
                if ticked and not sounds_healthy(n):
                    flash(f'"{n}" is ticked as NOT affected (healthy), but its name does not sound healthy. '
                          f'If that is wrong, untick it and save again.', "warning")
                elif (not ticked) and sounds_healthy(n):
                    flash(f'"{n}" sounds like a healthy class but is not ticked as "Not affected". '
                          f'If it is the healthy class, tick it and save again.', "warning")
            if not healthy:
                flash("No class is ticked as healthy, so every result will show as Affected.", "warning")
            return redirect(url_for("class_setup"))

    names = list(CLASS_NAMES)[:n_out] + [""] * max(0, n_out - len(CLASS_NAMES))
    healthy_flags = [n.strip().lower() in NOT_AFFECTED_CLASSES for n in names]
    return render_template("class_setup.html", n_out=n_out, names=names, healthy=healthy_flags,
                           condition=CONDITION_NAME)


