def _condition_kind(cond):
    """Rough category of the configured condition, used to pick suitable
    follow-up wording: 'foot', 'eye' or 'generic'."""
    import re
    c = (cond or "").lower()
    if re.search(r"foot|ulcer|wound|dfu", c):
        return "foot"
    if re.search(r"retinopath|\bdr\b|fundus|retina|eye", c):
        return "eye"
    return "generic"


def clinical_summary(record):
    """Clinical wording for one analysis, shared by the result page and the PDF.
    Never states a specific diagnosis the app does not know: it uses the
    configured condition name, or 'the target condition' if none is set."""
    cond = CONDITION_NAME or "the target condition"
    label = record.prediction_label
    outcome = verdict_for(label)
    conf = record.confidence * 100
    conf_txt = f"{conf:.1f}%"
    level = "high" if conf >= 85 else ("moderate" if conf >= 60 else "low")
    kind = _condition_kind(CONDITION_NAME)
    ranked = sorted(record.probabilities.items(), key=lambda kv: kv[1], reverse=True)
    runner = ranked[1] if len(ranked) > 1 else None
    runner_txt = (f" The next most likely category was '{runner[0]}' ({runner[1] * 100:.1f}%)."
                  if runner else "")

    if outcome == "Affected":
        headline = "SCREEN-POSITIVE"
        banner = f"Features suggestive of {cond} detected. Clinical review is advised."
        impression = f"Findings suggestive of {cond} (AI screening result: AFFECTED)."
        statement = (f"Automated analysis of the submitted clinical image identified features suggestive of "
                     f"{cond}. The model assigned a probability of {conf_txt} to the '{label}' category "
                     f"({level} confidence).{runner_txt} Image-based AI screening supports, but does not "
                     f"replace, clinical examination.")
    elif outcome == "Not affected":
        headline = "SCREEN-NEGATIVE"
        banner = f"No features suggestive of {cond} were identified."
        impression = f"No features suggestive of {cond} identified (AI screening result: NOT AFFECTED)."
        statement = (f"Automated analysis of the submitted clinical image did not identify features suggestive "
                     f"of {cond}. The model assigned a probability of {conf_txt} to the '{label}' category "
                     f"({level} confidence).{runner_txt} A negative screen does not exclude disease; "
                     f"clinical correlation remains necessary.")
    else:
        headline = "RESULT"
        banner = "Affected / not affected is not configured for this model."
        impression = f"Model output: {label} ({conf_txt})."
        statement = (f"The model assigned a probability of {conf_txt} to the '{label}' category ({level} "
                     f"confidence).{runner_txt} The clinical meaning of this category has not been configured, "
                     f"so the result should be interpreted by the treating clinician.")

    cautions = []
    if conf < 60:
        headline = "INDETERMINATE"
        cautions.append("Low model confidence: manual expert review is required before relying on this result.")
    if conf >= 99:
        cautions.append("A very high model score does not guarantee correctness, particularly if the image "
                        "differs from the images the model was trained on.")
    caution = " ".join(cautions) or None

    recs = {
        ("foot", "Affected"): [
            "Clinical examination of the lesion by the treating physician or wound-care specialist, including "
            "measurement, depth assessment and evaluation for signs of infection.",
            "Assess peripheral vascular status and sensory neuropathy (pedal pulses, ankle-brachial index, "
            "monofilament testing) according to local protocol.",
            "Review glycaemic control (HbA1c) and optimise diabetes management.",
            "Wound care and pressure off-loading as advised by the treating team.",
            "Seek urgent review for spreading redness, swelling, purulent discharge, odour, fever or "
            "increasing pain.",
        ],
        ("foot", "Not affected"): [
            "Continue daily self-inspection of the feet and wear appropriate protective footwear.",
            "Routine annual diabetic foot examination, more often if risk factors are present.",
            "Maintain glycaemic, blood-pressure and lipid control.",
            "Re-screen or seek review if a new wound, blister, colour change or swelling appears.",
        ],
        ("eye", "Affected"): [
            "Dilated fundus examination by an ophthalmologist to confirm the finding and grade severity.",
            "Referral timing to follow severity grading; urgent referral if vision changes are reported.",
            "Review and optimise glycaemic, blood-pressure and lipid control.",
        ],
        ("eye", "Not affected"): [
            "Continue routine periodic retinal screening as per guidelines.",
            "Maintain glycaemic, blood-pressure and lipid control.",
            "Seek review promptly if visual symptoms develop.",
        ],
        ("generic", "Affected"): [
            "Clinical correlation with history and examination by the treating clinician.",
            "Confirmatory investigation as per standard of care, with specialist referral as clinically indicated.",
            "Review and optimise diabetes control.",
        ],
        ("generic", "Not affected"): [
            "Routine follow-up as per clinical guidelines.",
            "Re-screen or seek review if new symptoms develop.",
        ],
    }
    recommendations = recs.get((kind, outcome)) or [
        "Correlate this model output with clinical examination.",
        "Follow-up is determined by the treating clinician.",
    ]
    if conf < 60:
        recommendations = recommendations + [
            "Repeat imaging with a clear, well-lit, in-focus close-up photograph and/or obtain expert review."]

    return {"outcome": outcome, "condition": cond, "headline": headline, "banner": banner,
            "impression": impression, "statement": statement, "caution": caution,
            "recommendations": recommendations, "confidence_text": conf_txt, "level": level}


def build_report_pdf(record, patient, filepath):
    """Builds the clinical-style PDF screening report and writes it to filepath."""
    from xml.sax.saxutils import escape as esc
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.units import mm
    from reportlab.lib import colors
    from reportlab.platypus import (BaseDocTemplate, PageTemplate, Frame, Paragraph, Spacer,
                                     Table, TableStyle, KeepTogether, HRFlowable, Image as RLImage)
    from reportlab.lib.styles import ParagraphStyle
    from reportlab.lib.enums import TA_CENTER
    from reportlab.graphics.shapes import Drawing, Rect
    from PIL import Image as PILImage

    summary = clinical_summary(record)
    outcome = summary["outcome"]
    PRIMARY = colors.HexColor("#5b21b6")
    ACCENT = colors.HexColor("#8b5cf6")
    LIGHT = colors.HexColor("#f5f3ff")
    TEXT = colors.HexColor("#1f2937")
    MUTED = colors.HexColor("#6b7280")
    BORDER = colors.HexColor("#e5e7eb")
    sev = colors.HexColor({"Affected": "#b91c1c", "Not affected": "#15803d"}.get(outcome, "#5b21b6"))
    if summary["headline"] == "INDETERMINATE":  # low confidence must not look reassuring
        sev = colors.HexColor("#b45309")

    W, H = A4
    LM = RM = 18 * mm
    CW = W - LM - RM

    lbl = ParagraphStyle("lbl", fontName="Helvetica-Bold", fontSize=7, leading=9, textColor=MUTED)
    val = ParagraphStyle("val", fontName="Helvetica", fontSize=9.5, leading=12, textColor=TEXT)
    h2 = ParagraphStyle("h2", fontName="Helvetica-Bold", fontSize=11.5, leading=14, textColor=PRIMARY, spaceBefore=8)
    body = ParagraphStyle("body", fontName="Helvetica", fontSize=9.2, leading=13.2, textColor=TEXT)
    small = ParagraphStyle("small", fontName="Helvetica", fontSize=7.8, leading=10.5, textColor=MUTED)
    cap = ParagraphStyle("cap", parent=small, alignment=TA_CENTER)
    bul = ParagraphStyle("bul", parent=body, leftIndent=11, firstLineIndent=-11, spaceAfter=3)
    sbul = ParagraphStyle("sbul", parent=small, leftIndent=9, firstLineIndent=-9, spaceAfter=2)
    title = ParagraphStyle("title", fontName="Helvetica-Bold", fontSize=17, leading=21, textColor=TEXT)
    sub = ParagraphStyle("sub", fontName="Helvetica", fontSize=9.5, leading=13, textColor=MUTED)
    head = ParagraphStyle("head", fontName="Helvetica-Bold", fontSize=15, leading=19, textColor=sev)
    imp = ParagraphStyle("imp", fontName="Helvetica-Bold", fontSize=10.5, leading=14.5, textColor=TEXT)
    warn = ParagraphStyle("warn", parent=body, textColor=colors.HexColor("#b45309"), fontSize=8.6, leading=12)
    disc = ParagraphStyle("disc", fontName="Helvetica", fontSize=7.8, leading=11, textColor=colors.HexColor("#7f1d1d"))

    created = record.created_at.strftime("%d %b %Y, %H:%M UTC") if record.created_at else "N/A"
    report_no = f"DV-{record.id:04d}"
    cond_title = (CONDITION_NAME or "Clinical").strip()

    def section(t):
        return [Paragraph(t, h2), HRFlowable(width="100%", thickness=0.8, color=ACCENT, spaceBefore=1, spaceAfter=6)]

    def decorate(canv, doc):
        canv.saveState()
        canv.setFillColor(PRIMARY)
        canv.rect(0, H - 26 * mm, W, 26 * mm, stroke=0, fill=1)
        canv.setFillColor(ACCENT)
        canv.rect(0, H - 27.2 * mm, W, 1.2 * mm, stroke=0, fill=1)
        canv.setFillColor(colors.white)
        canv.setFont("Helvetica-Bold", 19)
        canv.drawString(LM, H - 14 * mm, "DiaVision AI")
        canv.setFont("Helvetica", 8)
        canv.drawString(LM, H - 20 * mm, "INTELLIGENCE SUITE  |  AI-ASSISTED SCREENING REPORT")
        canv.setFont("Helvetica-Bold", 9.5)
        canv.drawRightString(W - RM, H - 13 * mm, f"Report No. {report_no}")
        canv.setFont("Helvetica", 8)
        canv.drawRightString(W - RM, H - 19 * mm, f"Generated: {created}")
        canv.setStrokeColor(BORDER)
        canv.setLineWidth(0.6)
        canv.line(LM, 15 * mm, W - RM, 15 * mm)
        canv.setFillColor(MUTED)
        canv.setFont("Helvetica", 7.5)
        canv.drawString(LM, 10.5 * mm, f"Confidential  |  Patient {patient.patient_code}  |  AI-generated decision support, not a final diagnosis.")
        canv.drawRightString(W - RM, 10.5 * mm, f"Page {doc.page}")
        canv.restoreState()

    story = [Paragraph("AI-Assisted Screening Report", title),
             Paragraph(f"{esc(cond_title)} screening from a clinical photograph", sub),
             Spacer(1, 6)]

    # ---- 1. Patient & examination details ---------------------------------
    name = (patient.name or "").strip() or "Not provided"
    duration = f"{patient.duration_years:g} years" if patient.duration_years else "N/A"
    P = lambda t: Paragraph(esc(str(t)), val)
    L = lambda t: Paragraph(t, lbl)
    details = Table([
        [L("PATIENT NAME"), P(name), L("PATIENT ID"), P(patient.patient_code)],
        [L("AGE / SEX"), P(f"{patient.age or 'N/A'} / {patient.gender or 'N/A'}"), L("DIABETES"),
         P(f"{patient.diabetes_type or 'N/A'}  ({duration})")],
        [L("EXAMINATION DATE"), P(created), L("REPORT NO."), P(report_no)],
        [L("REVIEWING CLINICIAN"), P(record.reviewed_by or "Pending review"), L("IMAGE TYPE"),
         P("Clinical photograph (digital)")],
    ], colWidths=[33 * mm, CW / 2 - 33 * mm, 29 * mm, CW / 2 - 29 * mm])
    details.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, -1), LIGHT),
        ("BOX", (0, 0), (-1, -1), 0.6, BORDER),
        ("LINEBELOW", (0, 0), (-1, -2), 0.4, colors.white),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("TOPPADDING", (0, 0), (-1, -1), 4.5),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 4.5),
        ("LEFTPADDING", (0, 0), (-1, -1), 8),
    ]))
    story += section("Patient & Examination Details") + [details]

    # ---- 2. Impression ----------------------------------------------------
    cell = [Paragraph("IMPRESSION", lbl), Spacer(1, 2),
            Paragraph(summary["headline"], head), Spacer(1, 2),
            Paragraph(esc(summary["impression"]), imp), Spacer(1, 4),
            Paragraph(esc(summary["statement"]), body)]
    if summary["caution"]:
        cell += [Spacer(1, 4), Paragraph("<b>Note:</b> " + esc(summary["caution"]), warn)]
    box = Table([[cell]], colWidths=[CW])
    box.setStyle(TableStyle([
        ("BOX", (0, 0), (-1, -1), 0.6, BORDER),
        ("LINEBEFORE", (0, 0), (0, 0), 4, sev),
        ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#fcfcfd")),
        ("TOPPADDING", (0, 0), (-1, -1), 9),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 9),
        ("LEFTPADDING", (0, 0), (-1, -1), 12),
        ("RIGHTPADDING", (0, 0), (-1, -1), 12),
    ]))
    story += section("Findings & Impression") + [box]

    # ---- 3. Model output --------------------------------------------------
    BAR_W = 70 * mm

    def bar(prob, top):
        d = Drawing(BAR_W, 4 * mm)
        d.add(Rect(0, 0, BAR_W, 4 * mm, fillColor=colors.HexColor("#ede9fe"), strokeColor=None))
        d.add(Rect(0, 0, max(BAR_W * prob, 0.6), 4 * mm, fillColor=(sev if top else ACCENT), strokeColor=None))
        return d

    ranked = sorted(record.probabilities.items(), key=lambda kv: kv[1], reverse=True)
    rows = [[Paragraph("CATEGORY", lbl), Paragraph("MODEL PROBABILITY", lbl), Paragraph("SCORE", lbl)]]
    for i, (label, prob) in enumerate(ranked):
        rows.append([Paragraph(f"<b>{esc(label)}</b>" if i == 0 else esc(label), val), bar(prob, i == 0),
                     Paragraph(f"<b>{prob * 100:.1f}%</b>" if i == 0 else f"{prob * 100:.1f}%", val)])
    pr = Table(rows, colWidths=[CW * 0.34, BAR_W + 6 * mm, CW - CW * 0.34 - BAR_W - 6 * mm])
    pr.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), LIGHT),
        ("LINEBELOW", (0, 0), (-1, -1), 0.4, BORDER),
        ("BOX", (0, 0), (-1, -1), 0.6, BORDER),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("TOPPADDING", (0, 0), (-1, -1), 4.5),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 4.5),
        ("LEFTPADDING", (0, 0), (-1, -1), 8),
    ]))
    story += [KeepTogether(section("Model Output") + [pr, Spacer(1, 3),
              Paragraph(f"Predicted category: <b>{esc(record.prediction_label)}</b>  |  "
                        f"Confidence: <b>{summary['confidence_text']}</b> ({summary['level']})", small)])]

    # ---- 4. Visual evidence ----------------------------------------------
    def fit_img(path, max_w, max_h):
        with PILImage.open(path) as im:
            w, h = im.size
        s = min(max_w / w, max_h / h)
        return RLImage(path, width=w * s, height=h * s)

    img_path = os.path.join(UPLOAD_FOLDER, record.image_filename)
    left = fit_img(img_path, 72 * mm, 56 * mm) if os.path.exists(img_path) else Paragraph("Image not available.", cap)
    right = Paragraph("Saliency map not available for this analysis.", cap)
    if record.gradcam_filename:
        gp = os.path.join(UPLOAD_FOLDER, record.gradcam_filename)
        if os.path.exists(gp):
            right = fit_img(gp, 72 * mm, 56 * mm)
    imgs = Table([[left, right],
                  [Paragraph("Figure 1. Submitted clinical photograph", cap),
                   Paragraph("Figure 2. Saliency map: warmer colours mark regions that most influenced the model", cap)]],
                 colWidths=[CW / 2, CW / 2])
    imgs.setStyle(TableStyle([
        ("ALIGN", (0, 0), (-1, -1), "CENTER"),
        ("VALIGN", (0, 0), (-1, 0), "MIDDLE"),
        ("BOX", (0, 0), (0, -1), 0.6, BORDER),
        ("BOX", (1, 0), (1, -1), 0.6, BORDER),
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#fafafa")),
        ("TOPPADDING", (0, 0), (-1, -1), 6),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 6),
    ]))
    story += [KeepTogether(section("Visual Evidence") + [imgs])]

    # ---- 5. Recommendations ----------------------------------------------
    recs = [Paragraph("\u2022  " + esc(r), bul) for r in summary["recommendations"]]
    story += [KeepTogether(section("Suggested Next Steps") + recs +
              [Paragraph("General guidance for consideration by the treating clinician; "
                         "it does not replace individual clinical judgement.", small)])]

    # ---- 6. Methodology & limitations --------------------------------------
    lim = [
        "Method: the photograph was analysed by an EfficientNet-based deep convolutional neural network; "
        "the saliency map was produced with gradient-based class activation mapping.",
        "The saliency map is indicative only. It highlights image regions that influenced the score and is not "
        "a lesion segmentation or measurement.",
        "Performance depends on image quality, framing, focus and lighting, and may be reduced for images that "
        "differ from the training data.",
        "This tool has not been validated as a stand-alone diagnostic device.",
    ]
    story += [KeepTogether(section("Methodology & Limitations") +
              [Paragraph("\u2022  " + esc(t), sbul) for t in lim])]

    # ---- 7. Sign-off + disclaimer ------------------------------------------
    sign = Table([["", ""],
                  [Paragraph(f"Reviewing clinician: <b>{esc(record.reviewed_by or '____________________')}</b>", small),
                   Paragraph("Signature / date / stamp", small)]],
                 colWidths=[CW * 0.55, CW * 0.45], rowHeights=[11 * mm, None])
    sign.setStyle(TableStyle([
        ("LINEABOVE", (0, 1), (0, 1), 0.6, TEXT),
        ("LINEABOVE", (1, 1), (1, 1), 0.6, TEXT),
        ("LEFTPADDING", (0, 0), (-1, -1), 0),
        ("RIGHTPADDING", (0, 0), (0, -1), 14),
    ]))
    disclaimer = Table([[Paragraph(
        "<b>Disclaimer:</b> This AI-generated analysis is intended for clinical decision support only and does "
        "not constitute a final medical diagnosis. All results must be reviewed by a qualified healthcare "
        "professional before any treatment planning.", disc)]], colWidths=[CW])
    disclaimer.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, -1), colors.HexColor("#fef2f2")),
        ("BOX", (0, 0), (-1, -1), 0.6, colors.HexColor("#fecaca")),
        ("TOPPADDING", (0, 0), (-1, -1), 7),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 7),
        ("LEFTPADDING", (0, 0), (-1, -1), 9),
        ("RIGHTPADDING", (0, 0), (-1, -1), 9),
    ]))
    story += [Spacer(1, 8), KeepTogether([sign, Spacer(1, 8), disclaimer])]

    doc = BaseDocTemplate(filepath, pagesize=A4, leftMargin=LM, rightMargin=RM,
                          topMargin=32 * mm, bottomMargin=20 * mm,
                          title=f"DiaVision AI Screening Report {report_no}", author="DiaVision AI")
    frame = Frame(LM, 20 * mm, CW, H - 32 * mm - 20 * mm, leftPadding=0, rightPadding=0,
                  topPadding=0, bottomPadding=0)
    doc.addPageTemplates([PageTemplate(id="main", frames=[frame], onPage=decorate)])
    doc.build(story)


@app.route("/reports/<int:analysis_id>/download")
@login_required
def download_report(analysis_id):
    record = Analysis.query.get_or_404(analysis_id)
    patient = record.patient
    filename = f"DiaVision_Report_{record.id:04d}_{patient.patient_code}.pdf"
    filepath = os.path.join(app.config["REPORTS_FOLDER"], filename)
    build_report_pdf(record, patient, filepath)
    return send_from_directory(app.config["REPORTS_FOLDER"], filename, as_attachment=True)


@app.route("/analytics")
@login_required
def analytics():
    counts = {name: 0 for name in CLASS_NAMES}
    for label, in db.session.query(Analysis.prediction_label).all():
        counts[label] = counts.get(label, 0) + 1
    total = sum(counts.values()) or 1
    avg_confidence = db.session.query(db.func.avg(Analysis.confidence)).scalar() or 0
    return render_template(
        "analytics.html",
        counts=counts,
        total=total,
        avg_confidence=avg_confidence,
        total_patients=Patient.query.count(),
        total_analyses=Analysis.query.count(),
    )


# ---------------------------------------------------------------------------
# Assistant — supports either Grok (xAI, api.x.ai) or Groq Cloud
# (api.groq.com — fast hosted inference for models like Llama). These are
# two different services with different keys, easy to mix up by name.
# Set GROK_API_KEY for xAI's Grok, or GROQ_API_KEY for Groq Cloud — set
# either (or both). Falls back to a rule-based responder if neither key
# works or the call fails for any reason.
#
# Reply format: the model is asked to answer in a light structure
# ("## Heading", "- bullet", "1. step", "**bold**", "Note: ...") which the
# chat page (templates/chatbot.html) renders as headings, lists and a note box.
# ---------------------------------------------------------------------------
GROK_API_KEY = os.environ.get("GROK_API_KEY", "").strip()
GROK_MODEL = os.environ.get("GROK_MODEL", "grok-4")
GROK_API_URL = "https://api.x.ai/v1/chat/completions"

GROQ_API_KEY = os.environ.get("GROQ_API_KEY", "").strip()
GROQ_MODEL = os.environ.get("GROQ_MODEL", "openai/gpt-oss-120b")
GROQ_API_URL = "https://api.groq.com/openai/v1/chat/completions"

if GROK_API_KEY:
    print(f"[DiaVision] Grok (xAI) assistant: ENABLED ({GROK_MODEL})")
if GROQ_API_KEY:
    print(f"[DiaVision] Groq Cloud assistant: ENABLED ({GROQ_MODEL})")
if not GROK_API_KEY and not GROQ_API_KEY:
    print("[DiaVision] No GROK_API_KEY or GROQ_API_KEY set — chatbot using rule-based fallback only.")

ASSISTANT_SYSTEM_PROMPT = (
    "You are the DiaVision Assistant, embedded in a diabetic retinopathy screening "
    "dashboard used by clinicians. Be concise and clinically accurate. You can explain DR "
    "grading, general diabetic eye disease education, suggest sensible next clinical steps "
    "for a given finding (follow-up interval, referral to ophthalmology), and answer "
    "questions about using the app (New Analysis, Patients, History, Reports, Analytics). "
    "You have no live access to this session's patient records or images unless the user "
    "pastes details into the chat. Never present your output as a final diagnosis or "
    "treatment order.\n\n"
    "FORMAT RULES (very important, follow exactly):\n"
    "- Start with ONE short sentence that directly answers the question.\n"
    "- Then use 2 to 4 sections. Each section starts with its own line like '## Section title'.\n"
    "- Under each section use short bullets, each on its own line starting with '- '. "
    "Use '1. ', '2. ', '3. ' on separate lines for step-by-step instructions. "
    "Keep bullets short (about 12 words or fewer).\n"
    "- Put key terms in **bold**.\n"
    "- Never write a paragraph longer than 2 lines.\n"
    "- For a very simple question (greeting, yes/no), answer in 1 to 2 short sentences "
    "with no sections.\n"
    "- When you give clinical suggestions, end with one line starting 'Note:' saying the "
    "suggestion needs review by the attending clinician.\n"
    "- No tables, no HTML, no emojis. Keep the whole answer under 180 words."
)

# Each entry: (keywords, structured answer). First match wins, so keep the
# MORE SPECIFIC entries above the general ones. Short keywords (3 letters or
# fewer) must match as whole words; longer ones match as word prefixes.
KB = [
    (["grade", "grading", "stage", "stages", "severity", "mild", "moderate", "severe", "proliferative", "npdr", "pdr"],
     "Diabetic retinopathy is graded in five levels, from no disease to vision-threatening disease.\n\n"
     "## The 5 grades\n"
     "- **No DR:** no visible retinal signs\n"
     "- **Mild:** microaneurysms only\n"
     "- **Moderate:** hemorrhages and hard exudates\n"
     "- **Severe:** extensive hemorrhages, venous beading\n"
     "- **Proliferative:** new fragile vessels, highest risk of vision loss\n\n"
     "## Why grading matters\n"
     "- It decides the follow-up interval\n"
     "- It decides how urgent the referral is\n\n"
     "Note: AI suggestions require review by the attending clinician."),

    (["follow-up", "follow up", "followup", "next step", "next steps", "refer", "referral", "treatment", "treat", "manage"],
     "Follow-up depends on the DR grade, and the treating clinician makes the final decision.\n\n"
     "## Typical follow-up\n"
     "- **No or mild DR:** routine screening about every 12 months\n"
     "- **Moderate DR:** ophthalmology review within 3 to 6 months\n"
     "- **Severe or proliferative DR:** urgent ophthalmology referral\n\n"
     "## For every patient\n"
     "- Optimise blood sugar, blood pressure and lipids\n"
     "- Report any sudden vision change at once\n\n"
     "Note: these are general suggestions and need clinician review."),

    (["heatmap", "grad-cam", "gradcam", "grad cam", "saliency", "highlight", "highlighted"],
     "The heatmap shows which parts of the image influenced the model's prediction most.\n\n"
     "## How to read it\n"
     "- **Warm colours (red, yellow):** most influence on the result\n"
     "- **Cool or no colour:** little influence\n\n"
     "## Limits\n"
     "- It is indicative only, not a lesion outline\n"
     "- It cannot replace a clinical examination\n\n"
     "Note: AI suggestions require review by the attending clinician."),

    (["analytics", "chart", "charts", "statistics", "stats", "dashboard"],
     "The Analytics and Dashboard pages summarise all screenings done so far.\n\n"
     "## What you can see\n"
     "- Total patients and total analyses\n"
     "- How many results fall in each class\n"
     "- Average model confidence\n"
     "- Recent patients and recent analyses (Dashboard)"),

    (["history", "past", "previous", "earlier", "filter"],
     "Prediction History lists every earlier analysis, newest first.\n\n"
     "## What you can do\n"
     "- Filter the list by predicted class\n"
     "- Open any row to see its full result page\n"
     "- Download the PDF report for that analysis"),

    (["patient", "patients", "add patient", "new patient", "profile"],
     "Patients are created while running an analysis, and each patient keeps their own history.\n\n"
     "## Add a patient\n"
     "1. Open **New Analysis**\n"
     "2. Choose **new** in the patient selector\n"
     "3. Fill in the patient details\n"
     "4. Upload the image and run the analysis\n\n"
     "## View a patient\n"
     "- Open **Patients**, search by name or ID, then click the patient"),

    (["upload", "new analysis", "run analysis", "analyse", "analyze", "diagnosis", "scan", "image", "how do i", "how to"],
     "Running an analysis takes four quick steps.\n\n"
     "## Steps\n"
     "1. Open **New Analysis**\n"
     "2. Pick an existing patient or add a new one\n"
     "3. Upload a clear, well-lit, in-focus image (PNG, JPG, TIFF or BMP, up to 20 MB)\n"
     "4. Click run, and you go straight to the result page\n\n"
     "## Tip\n"
     "- Sharp, well-framed images give more reliable results"),

    (["report", "reports", "download", "pdf", "print"],
     "You can download a PDF screening report for any analysis.\n\n"
     "## Where to find it\n"
     "- On the **Reports** page, for any past analysis\n"
     "- Directly from any **result** page\n\n"
     "## What the PDF contains\n"
     "- Patient details and the impression\n"
     "- Class probabilities and the heatmap\n"
     "- Suggested next steps and limitations"),

    (["confidence", "accuracy", "accurate", "reliable", "trust", "probability", "score"],
     "Confidence is the model's probability for its top class, and it is not a guarantee of correctness.\n\n"
     "## How to use it\n"
     "- **85% or higher:** high confidence\n"
     "- **60 to 85%:** moderate, review carefully\n"
     "- **Below 60%:** low, expert review is required\n\n"
     "## Remember\n"
     "- Even a very high score can be wrong on unusual images\n"
     "- Always correlate with clinical examination\n\n"
     "Note: AI suggestions require review by the attending clinician."),

    (["dr", "retinopathy", "diabetic eye", "what is"],
     "Diabetic retinopathy (DR) is damage to the retina's blood vessels caused by long-term high blood sugar.\n\n"
     "## What happens\n"
     "- Tiny vessels leak or close off\n"
     "- In advanced disease, fragile new vessels grow\n"
     "- Swelling at the macula can reduce central vision\n\n"
     "## Why screening matters\n"
     "- Early DR usually has no symptoms\n"
     "- Early treatment can prevent vision loss\n\n"
     "Note: AI suggestions require review by the attending clinician."),

    (["hi", "hii", "hello", "hey", "good morning", "good afternoon", "good evening", "thanks", "thank you"],
     "Hello! I'm the DiaVision Assistant.\n\n"
     "## I can help with\n"
     "- DR grades and what they mean\n"
     "- Suggested next steps and follow-up\n"
     "- Running analyses and reading results\n"
     "- Patients, history, reports and analytics"),
]


def _kw_in_text(keyword, text):
    """Whole-word match for short keywords, word-prefix match for longer ones,
    so 'dr' does not fire inside 'address' or 'drug'."""
    import re
    k = re.escape(keyword)
    pattern = rf"\b{k}\b" if len(keyword) <= 3 else rf"\b{k}"
    return re.search(pattern, text) is not None


def rule_based_reply(message):
    text = message.lower()
    for keywords, answer in KB:
        if any(_kw_in_text(k, text) for k in keywords):
            return answer
    return ("I can help with questions about diabetic retinopathy grading, using the analysis "
            "workflow, or your reports.\n\n"
            "## Try asking\n"
            "- What are the DR grades?\n"
            "- What follow-up is suggested for moderate DR?\n"
            "- How do I run a new analysis?\n"
            "- How do I download a report?\n\n"
            "(Set GROK_API_KEY or GROQ_API_KEY in .env for richer, LLM-powered answers.)")


def clean_reply(text):
    """Normalises model output into the light structure the chat page renders:
    '## Heading', '- bullet', '1. step', **bold**, and 'Note: ...' lines.
    Tables and HTML are flattened because the page does not render them."""
    import re
    lines = []
    for line in text.splitlines():
        s = line.strip()
        if s and "-" in s and re.fullmatch(r"[|\s:\-]+", s):   # table separator row
            continue
        if s.startswith("|") and s.endswith("|"):            # table row -> one line
            cells = [c.strip() for c in s.strip("|").split("|") if c.strip()]
            s = " - ".join(cells)
        lines.append(s)
    text = "\n".join(lines)
    text = re.sub(r"<br\s*/?>", "\n", text, flags=re.I)       # <br> -> newline
    text = re.sub(r"<[^>]+>", "", text)                      # drop other HTML tags
    text = re.sub(r"^\s*---+\s*$", "", text, flags=re.M)      # horizontal rules
    text = re.sub(r"^#{1,6}\s*", "## ", text, flags=re.M)     # normalise all headings to '## '
    text = re.sub(r"^\s*[*\u2022]\s+", "- ", text, flags=re.M)  # * or bullet -> '- '
    text = re.sub(r"__(.+?)__", r"**\1**", text)              # __bold__ -> **bold**
    text = re.sub(r"[ \t]+\n", "\n", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def _call_openai_compatible(url, api_key, model, message, history):
    import requests
    messages = [{"role": "system", "content": ASSISTANT_SYSTEM_PROMPT}]
    messages.extend(history)
    messages.append({"role": "user", "content": message})

    resp = requests.post(
        url,
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        json={"model": model, "messages": messages, "temperature": 0.3},
        timeout=20,
    )
    resp.raise_for_status()
    data = resp.json()
    return clean_reply(data["choices"][0]["message"]["content"])


LLM_LAST_ERROR = {}   # service name -> short reason for the last failure (never contains keys)


def _describe_llm_error(exc):
    resp = getattr(exc, "response", None)
    if resp is not None:
        code = resp.status_code
        hint = {401: "the API key was rejected (wrong, deleted or revoked)",
                403: "access denied for this key or model",
                404: "model not found (name wrong or retired)",
                400: "request rejected (often a retired or wrong model name)",
                429: "rate limit reached, try again shortly"}.get(code, "service error")
        return f"HTTP {code}: {hint}"
    return f"{type(exc).__name__}: could not reach the service (check internet or firewall)"


def grok_reply(message, history):
    """Calls xAI's Grok API. Returns None (never raises) on any failure so
    the caller can fall back cleanly — missing key, network error, bad
    response, whatever."""
    if not GROK_API_KEY:
        return None
    try:
        reply = _call_openai_compatible(GROK_API_URL, GROK_API_KEY, GROK_MODEL, message, history)
        LLM_LAST_ERROR["grok"] = None
        return reply
    except Exception as exc:  # pragma: no cover
        LLM_LAST_ERROR["grok"] = _describe_llm_error(exc)
        app.logger.warning("Grok (xAI) API call failed, falling back: %s", exc)
        return None


def groq_reply(message, history):
    """Calls Groq Cloud's OpenAI-compatible API. Same never-raises contract
    as grok_reply()."""
    if not GROQ_API_KEY:
        return None
    if GROQ_API_KEY.upper().startswith("PASTE"):
        LLM_LAST_ERROR["groq"] = "GROQ_API_KEY in .env is still the placeholder text; paste your real key"
        return None
    try:
        reply = _call_openai_compatible(GROQ_API_URL, GROQ_API_KEY, GROQ_MODEL, message, history)
        LLM_LAST_ERROR["groq"] = None
        return reply
    except Exception as exc:  # pragma: no cover
        LLM_LAST_ERROR["groq"] = _describe_llm_error(exc)
        app.logger.warning("Groq Cloud API call failed, falling back: %s", exc)
        return None


def llm_reply(message, history):
    """Tries Groq first (since that's what most people setting GROQ_API_KEY
    actually want — fast + often free-tier), then Grok, then the
    rule-based fallback. Returns (reply, source)."""
    for name, fn in (("groq", groq_reply), ("grok", grok_reply)):
        reply = fn(message, history)
        if reply is not None:
            return reply, name
    reply = rule_based_reply(message)
    problems = [f"{name.capitalize()}: {why}" for name, why in LLM_LAST_ERROR.items() if why]
    if (GROQ_API_KEY or GROK_API_KEY) and problems:
        reply = (reply.split("(Set GROK_API_KEY")[0].strip()
                 + "\n\nNote: the online AI assistant is unavailable right now (" + "; ".join(problems)
                 + "). This is the built-in helper. Check .env and restart the app.")
    return reply, "rules"


@app.route("/chatbot")
@login_required
def chatbot():
    return render_template("chatbot.html", grok_enabled=bool(GROK_API_KEY), groq_enabled=bool(GROQ_API_KEY))


@app.route("/api/chatbot", methods=["POST"])
@login_required
def api_chatbot():
    from flask import session

    data = request.get_json(silent=True) or {}
    message = (data.get("message") or "").strip()
    if not message:
        return jsonify({"reply": "Please type a question."}), 400

    history = session.get("chat_history", [])
    reply, source = llm_reply(message, history)

    history.append({"role": "user", "content": message})
    history.append({"role": "assistant", "content": reply})
    session["chat_history"] = history[-12:]  # keep last ~6 exchanges for context

    return jsonify({"reply": reply, "source": source})


@app.route("/api/chatbot/reset", methods=["POST"])
@login_required
def api_chatbot_reset():
    from flask import session
    session.pop("chat_history", None)
    return jsonify({"ok": True})


